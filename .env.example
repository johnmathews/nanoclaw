# NanoClaw environment variables.
# Full reference with defaults: docs/SPEC.md §15.
# Secrets stay in this file (gitignored); only the credential proxy reads them.

# --- Core ---
ASSISTANT_NAME=agent
ASSISTANT_HAS_OWN_NUMBER=

# --- Channel tokens ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# --- Container ---
CONTAINER_IMAGE=nanoclaw-agent:latest
CONTAINER_TIMEOUT=1800000
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_CPU_LIMIT=2
CONTAINER_MAX_OUTPUT_SIZE=10485760
MAX_CONCURRENT_CONTAINERS=5
MAX_MESSAGES_PER_PROMPT=10
IDLE_TIMEOUT=1800000

# --- Networking ---
CREDENTIAL_PROXY_PORT=3001
HEALTH_PORT=3002

# --- Optional MCP servers ---
DOCS_MCP_URL=
JOURNAL_MCP_URL=
JOURNAL_API_TOKEN=
PARALLEL_API_KEY=

# --- GitHub (passed through to containers if set) ---
GITHUB_TOKEN=

# --- Custom model endpoint (optional) ---
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# --- Operations ---
LOG_LEVEL=info
TZ=
